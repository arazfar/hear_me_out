{
  "name": "hear-me-out",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node scripts/demo.mjs",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "tunnel": "cloudflared tunnel --url http://127.0.0.1:3000 --no-autoupdate",
    "verify:providers": "tsx scripts/provider-smoke.ts",
    "verify:judge": "tsx scripts/judge-check.ts",
    "verify:match": "tsx scripts/socket-check.ts",
    "verify:idle": "tsx scripts/idle-check.ts"
  },
  "dependencies": {
    "@cartesia/cartesia-js": "4.2.0",
    "@fontsource/bungee": "^5.2.5",
    "@fontsource/space-grotesk": "^5.2.10",
    "@react-three/fiber": "9.8.1",
    "dotenv": "^17.2.3",
    "express": "5.2.1",
    "openai": "7.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "ws": "^8.18.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "8.3.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

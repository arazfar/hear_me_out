  "transcripts": [
    {
      "playerId": "439750e9-e06f-4c65-a1a8-cabf5a1c83f8",
      "roundId": "97ec7097-bef4-41e8-abe5-442fac62ed25",
      "turnId": "78362168-272a-4d1a-9725-edaf462bd869",
      "text": "Pancakes are better because I like them."
    },
    {
      "playerId": "ebc799a4-925d-450d-a731-42aef9ebe1e2",
      "roundId": "97ec7097-bef4-41e8-abe5-442fac62ed25",
      "turnId": "62245c69-a471-49e1-b381-40526bb4f6bf",
      "text": "Yeah, face have syrup pockets, so sweetness reaches every bite instead of pooling under the last bite."
    },
    {
      "playerId": "439750e9-e06f-4c65-a1a8-cabf5a1c83f8",
      "roundId": "97ec7097-bef4-41e8-abe5-442fac62ed25",
      "turnId": "c8867f73-da5c-4f99-8894-602f3b1dca7e",
      "text": "I heard the Sierra point, but I still prefer pancakes."
    },
    {
      "playerId": "ebc799a4-925d-450d-a731-42aef9ebe1e2",
      "roundId": "97ec7097-bef4-41e8-abe5-442fac62ed25",
      "turnId": "34c58358-7f2f-498b-8e6f-23fa2e5f7882",
      "text": "Softness is not enough. Pancakes soak up syrup and lose their texture, while waffles keep a crisp edge."
    },
    {
      "playerId": "439750e9-e06f-4c65-a1a8-cabf5a1c83f8",
      "roundId": "97ec7097-bef4-41e8-abe5-442fac62ed25",
      "turnId": "21e781e2-a8b3-4f16-b1e0-d1cbbfed6e9f",
      "text": "Pancakes are my favorite breakfast."
    },
    {
      "playerId": "ebc799a4-925d-450d-a731-42aef9ebe1e2",
      "roundId": "97ec7097-bef4-41e8-abe5-442fac62ed25",
      "turnId": "ee5f088e-72fe-4325-89a6-d6a4d88f86f3",
      "text": "Even syrup distribution matters more than softness because breakfast should taste balanced from first bite to last."
    },
    {
      "playerId": "ebc799a4-925d-450d-a731-42aef9ebe1e2",
      "roundId": "25350262-2f1f-4468-8084-e857c54ab0bd",
      "turnId": "eb205b8f-b4df-4c3c-83ac-7e0449284b7e",
      "text": "Waffles have syrup pockets, so sweetness reaches every bite instead of pooling under the last bite."
    },
    {

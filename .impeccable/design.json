      "css": ".ds-code{font-family:var(--font-body,\"Nunito Sans\",sans-serif);display:flex;align-items:center;gap:12px;min-width:44px;min-height:44px;padding:10px 16px;border:0;border-radius:12px;background:var(--surface-panel, #24314B);color:var(--text-primary, #F6F8FF);font-size:13px;cursor:pointer;transition:background var(--quick,160ms),transform var(--quick,160ms) var(--ease,cubic-bezier(0.16,1,0.3,1)),box-shadow var(--quick,160ms);}.ds-code b{font-size:20px;font-variant-numeric:tabular-nums;letter-spacing:.12em}.ds-code svg{width:20px;height:20px;flex:0 0 auto}.ds-code:hover{background:var(--surface-hover, #3B4E6B)}.ds-code:active{transform:translateY(2px)}.ds-code:focus-visible{outline:3px solid var(--border-focus, #F6F8FF);outline-offset:2px;box-shadow:0 0 0 2px var(--border-focus-gap, #151E32) !important;}"
    },
    {
      "name": "Slate entry panel",
      "kind": "card",
      "refersTo": "card-entry",
      "description": "Ice-white text on slate with soft depth; sample copy shows hierarchy.",
      "html": "<section class=\"ds-entry\"><h2>Take your seat</h2><p>Start a room. Your friend joins with a code.</p></section>",
      "css": ".ds-entry{font-family:var(--font-body,\"Nunito Sans\",sans-serif);background:var(--surface-panel, #24314B);color:var(--text-primary, #F6F8FF);padding:32px;border-radius:var(--radius,16px);box-shadow:var(--shadow,0 12px 30px #151E3255)}.ds-entry h2{font-family:var(--font-display,\"Lilita One\",sans-serif);font-size:34px;font-weight:400;line-height:1.12;letter-spacing:0;margin:0}.ds-entry p{font-size:16px;font-weight:500;line-height:1.45;color:var(--text-secondary, #BFCBE0);margin:12px 0 28px;max-width:32ch}@media(max-width:700px){.ds-entry{padding:20px}.ds-entry h2{font-size:26px}.ds-entry p{font-size:14px;margin:8px 0 20px}}"
    },

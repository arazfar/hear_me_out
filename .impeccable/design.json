      "html": "<div class=\"ds-caption\"><span class=\"ds-speaker\">Alex</span><p>My argument is simple: every meeting needs a snack break.</p></div>",
      "css": ".ds-caption{font-family:var(--font-body,\"Nunito Sans\",sans-serif);display:flex;align-items:flex-start;gap:16px;padding:16px 20px;border-radius:12px;background:var(--surface-panel, #24314B);color:var(--text-primary, #F6F8FF)}.ds-speaker{font-size:13px;font-weight:700;color:var(--identity-seat0-base, #55D6CB);padding-top:2px;overflow-wrap:anywhere}.ds-caption p{font-size:15px;font-weight:500;line-height:1.45;white-space:pre-wrap;overflow-wrap:anywhere;min-width:0;margin:0}@media(max-width:700px){.ds-caption{padding:10px;gap:8px;flex-wrap:wrap}.ds-caption p{font-size:14px}}"

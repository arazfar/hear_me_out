  "narrative": {
    "northStar": "Tangerine Arcade",
    "overview": "Tangerine Arcade is a midnight toy courtroom for two friends making ridiculous arguments. Slate panels carry the conversation, ice-white text keeps it readable, and equally prominent turquoise and lilac identify the players. Tangerine belongs to Bonk and shared primary actions. The contrast between silly opinions and fair treatment remains the enduring character.\n\nRounded painted frames, Lilita One lettering, and Nunito Sans controls connect the live faces to the procedural courtroom. The approved change replaces color roles and scene materials while retaining composition, type, geometry, motion, media ownership, and behavior. PRODUCT.md governs behavior and claims; .impeccable/surfaces/src-app-tsx.md records the approved direction. Validation scope and remaining release work are recorded in docs/design/tangerine-arcade/README.md; this system document does not certify test or CI completion.",
    "keyCharacteristics": [
      "Midnight and slate reading surfaces with ice-white text and dark form controls.",
      "Permanent turquoise/lilac player identities, independent of shared tangerine actions and labeled statuses.",
      "A matte tangerine procedural host with painted-blue furniture and restrained lighting.",
      "Existing composition, typography, motion, and media behavior retained."
    ],
    "rules": [
      {
        "name": "The One Source Rule",
        "body": "Change semantic values in src/design/tokens.ts. DOM custom properties, React identity helpers, Three.js materials and lighting, the document theme color, and generated favicon consume that source; DESIGN.md records the implemented system.",
        "section": "colors"
      },
      {
        "name": "The Permanent Seats Rule",
        "body": "Seat 0 stays turquoise and seat 1 stays lilac on both clients. Color follows the server-assigned seat, never local/remote position, speaking order, score rank, or winner status.",
        "section": "colors"
      },
      {
        "name": "The Separate Meanings Rule",
        "body": "Keep player identity, shared actions, and labeled status on their own semantic roles. Deliberate mic/camera privacy is neutral; failures use error styling. Low-time clocks use warning text.",
        "section": "colors"
      },
      {
        "name": "The Readable Conversation Rule",
        "body": "Use Nunito Sans for user content, scores, timers, controls, and captions. Reserve Lilita One for the brand, short panel titles, initials, and celebratory lettering.",
        "section": "typography"
      },
      {
        "name": "The Quiet Depth Rule",
        "body": "Use soft ambient shadows and tonal slate layering around the content. Keep the shallow inset tangerine button shadow as a painted-material cue.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the pinned pigments through separate semantic roles and the shared token source.",
      "Do keep full names, propositions, positions, and captions visible; wrap or scroll long content.",
      "Do preserve media nodes across layout and phase changes through CSS placement and stable seat components.",
      "Do retain the visible Voice label on phones and distinguish activity, scoring eligibility, and mic privacy.",
      "Do keep deliberate mic/camera privacy neutral and use explicit labels/icons alongside status color.",
      "Do provide visible focus, at least 44px interactive targets, reduced motion, and usable controls when WebGL fails.",
      "Do recapture the procedural fallback and preserve its provenance when the scene changes."
    ],
    "donts": [
      "Don't swap player identities when a player leaves, a turn changes, or the local client is the second seat.",
      "Don't use ice-white as the general panel or field background; reading surfaces stay slate and fields stay dark.",
      "Don't use display lettering for long arguments, infer scoring eligibility from audio level, or describe Mic on as permission to score.",
      "Don't truncate user-authored content or cover live faces and controls with celebration.",
      "Don't add emissive glow, tint live video, or make identity colors stand in for shared actions.",
      "Don't replace the procedural scene or live media with generated model imagery.",
      "Don't present synthetic browser coverage as physical-device, live-provider, production, or statistical-fairness validation."
    ]
  }
}

  "components": [
    {
      "name": "Brass primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Full-width next action with hover, press, focus, and disabled states.",
      "html": "<button class=\"ds-primary\">Create room</button>",
      "css": ".ds-primary{font-family:var(--font-body,\"Nunito Sans\",sans-serif);display:flex;align-items:center;justify-content:center;gap:12px;width:100%;min-width:44px;min-height:48px;padding:12px 18px;border:0;border-radius:var(--radius-small,12px);background:var(--brass, #D9B464);color:var(--canvas, #26131E);font-size:15px;font-weight:700;box-shadow:var(--shadow-button,inset 0 -3px 0 #89632955,0 4px 10px #160B1333);cursor:pointer;transition:background var(--quick,160ms),transform var(--quick,160ms) var(--ease,cubic-bezier(0.16,1,0.3,1)),box-shadow var(--quick,160ms);}.ds-primary:not(:disabled):hover{background:var(--action-hover, #EBCB86);transform:translateY(-1px)}.ds-primary:not(:disabled):active{background:var(--action-pressed, #C9A153);transform:translateY(2px) scale(.98);transition-duration:70ms}.ds-primary:focus-visible{outline:3px solid var(--brass,#D9B464);outline-offset:4px;}.ds-primary:disabled{background:var(--disabled-fill, #604858);color:var(--disabled-text, #E3CED9);box-shadow:none;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Underlined text action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Secondary choice below the primary action.",
      "html": "<button class=\"ds-text\">Join a friend</button>",
      "css": ".ds-text{font-family:var(--font-body,\"Nunito Sans\",sans-serif);display:block;min-width:44px;min-height:44px;padding:6px 8px;margin:12px auto 0;border:0;background:transparent;color:var(--cream, #FFF3DF);font-size:13px;text-decoration:underline;text-underline-offset:4px;cursor:pointer;transition:background var(--quick,160ms),transform var(--quick,160ms) var(--ease,cubic-bezier(0.16,1,0.3,1)),box-shadow var(--quick,160ms);}.ds-text:hover{color:var(--brass, #D9B464)}.ds-text:active{transform:translateY(2px)}.ds-text:focus-visible{outline:3px solid var(--brass,#D9B464);outline-offset:4px;}"
    },
    {
      "name": "Circular help control",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Header help with a stroke SVG and accessible name.",
      "html": "<button class=\"ds-icon\" aria-label=\"How to play\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 8a3 3 0 1 1 4 3c-1 .5-1 1-1 3M12 18h.01M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z\"/></svg></button>",
      "css": ".ds-icon{display:inline-grid;place-items:center;width:44px;height:44px;min-width:44px;min-height:44px;border:0;border-radius:50%;background:var(--surface, #40263B);color:var(--cream, #FFF3DF);cursor:pointer;transition:background var(--quick,160ms),transform var(--quick,160ms) var(--ease,cubic-bezier(0.16,1,0.3,1)),box-shadow var(--quick,160ms);}.ds-icon svg{width:20px;height:20px;flex:0 0 auto}.ds-icon:hover{background:var(--surface-hover, #63465A)}.ds-icon:active{transform:translateY(2px)}.ds-icon:focus-visible{outline:3px solid var(--brass,#D9B464);outline-offset:4px;}"
    },
    {
      "name": "Light input field",
      "kind": "input",
      "refersTo": "input",
      "description": "Light field within the plum form and a persistent visible label.",
      "html": "<label class=\"ds-label\" for=\"ds-name\">Your name</label><input class=\"ds-input\" id=\"ds-name\" placeholder=\"Your name\" autocomplete=\"off\">",
      "css": ".ds-label{font-family:var(--font-body,\"Nunito Sans\",sans-serif);display:block;color:var(--cream, #FFF3DF);font-size:14px;font-weight:600;margin:0 0 8px}.ds-input{font-family:var(--font-body,\"Nunito Sans\",sans-serif);width:100%;min-width:0;padding:12px 14px;border:1.5px solid var(--field-stroke, #956B80);border-radius:var(--radius-small,12px);background:var(--field, #FFF8EC);color:var(--canvas, #26131E);caret-color:var(--paper-copy, #654354);color-scheme:light;font-size:16px}.ds-input::placeholder{color:var(--paper-copy, #654354)}.ds-input:focus-visible{outline:3px solid var(--brass,#D9B464);outline-offset:4px;}"
    },
    {
      "name": "Room code control",
      "kind": "button",
      "refersTo": "room-code",
      "description": "Copyable room identity; the sample code is illustrative.",
      "html": "<button class=\"ds-code\" aria-label=\"Copy room code 4821\"><span>Room</span><b>4821</b><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 8h10v13H9zM15 8V3H4v13h5\"/></svg></button>",
      "css": ".ds-code{font-family:var(--font-body,\"Nunito Sans\",sans-serif);display:flex;align-items:center;gap:12px;min-width:44px;min-height:44px;padding:10px 16px;border:0;border-radius:12px;background:var(--surface, #40263B);color:var(--cream, #FFF3DF);font-size:13px;cursor:pointer;transition:background var(--quick,160ms),transform var(--quick,160ms) var(--ease,cubic-bezier(0.16,1,0.3,1)),box-shadow var(--quick,160ms);}.ds-code b{font-size:20px;font-variant-numeric:tabular-nums;letter-spacing:.12em}.ds-code svg{width:20px;height:20px;flex:0 0 auto}.ds-code:hover{background:var(--surface-hover, #63465A)}.ds-code:active{transform:translateY(2px)}.ds-code:focus-visible{outline:3px solid var(--brass,#D9B464);outline-offset:4px;}"
    },
    {
      "name": "Plum entry panel",
      "kind": "card",
      "refersTo": "card-entry",
      "description": "Cream text on plum with soft depth; sample copy shows hierarchy.",
      "html": "<section class=\"ds-entry\"><h2>Take your seat</h2><p>Start a room. Your friend joins with a code.</p></section>",
      "css": ".ds-entry{font-family:var(--font-body,\"Nunito Sans\",sans-serif);background:var(--surface, #40263B);color:var(--cream, #FFF3DF);padding:32px;border-radius:var(--radius,16px);box-shadow:var(--shadow,0 12px 30px #160B1355)}.ds-entry h2{font-family:var(--font-display,\"Lilita One\",sans-serif);font-size:34px;font-weight:400;line-height:1.12;letter-spacing:0;margin:0}.ds-entry p{font-size:16px;font-weight:500;line-height:1.45;color:var(--muted, #D6BDCA);margin:12px 0 28px;max-width:32ch}@media(max-width:700px){.ds-entry{padding:20px}.ds-entry h2{font-size:26px}.ds-entry p{font-size:14px;margin:8px 0 20px}}"
    },
    {
      "name": "Scoring eligibility badge",
      "kind": "chip",
      "refersTo": "status-eligible-seat0",
      "description": "Noninteractive scoring badge; voice activity remains a separate signal.",
      "html": "<span class=\"ds-eligible\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 9a6 6 0 0 1 12 0c0 4-4 4-4 7a4 4 0 0 1-8 0M9 9a3 3 0 0 1 6 0c0 2-3 2-3 4\"/></svg><span>Bonk is scoring</span></span>",
      "css": ".ds-eligible{font-family:var(--font-body,\"Nunito Sans\",sans-serif);display:inline-flex;align-items:center;gap:6px;min-height:22px;padding:3px 6px;border-radius:8px;background:var(--seat0, #A8D5F2);color:var(--canvas, #26131E);font-size:11px;line-height:1.3}.ds-eligible svg{width:14px;height:14px;flex-shrink:0}"
    },
    {
      "name": "Player caption",
      "kind": "custom",
      "refersTo": "caption",
      "description": "Full wrapping caption with permanent seat identity; sample text is illustrative.",
      "html": "<div class=\"ds-caption\"><span class=\"ds-speaker\">Alex</span><p>My argument is simple: every meeting needs a snack break.</p></div>",
      "css": ".ds-caption{font-family:var(--font-body,\"Nunito Sans\",sans-serif);display:flex;align-items:flex-start;gap:16px;padding:16px 20px;border-radius:12px;background:var(--surface, #40263B);color:var(--cream, #FFF3DF)}.ds-speaker{font-size:13px;font-weight:700;color:var(--seat0, #A8D5F2);padding-top:2px;overflow-wrap:anywhere}.ds-caption p{font-size:15px;font-weight:500;line-height:1.45;white-space:pre-wrap;overflow-wrap:anywhere;min-width:0;margin:0}@media(max-width:700px){.ds-caption{padding:10px;gap:8px;flex-wrap:wrap}.ds-caption p{font-size:14px}}"
    },
    {
      "name": "Device dock control",
      "kind": "button",
      "refersTo": "button-control",
      "description": "Labeled mic privacy control independent of scoring eligibility.",
      "html": "<button class=\"ds-control\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 5a3 3 0 0 1 6 0v7a3 3 0 0 1-6 0V5ZM5 10v2a7 7 0 0 0 14 0v-2M12 19v3M8 22h8\"/></svg><span>Mic on</span></button>",
      "css": ".ds-control{font-family:var(--font-body,\"Nunito Sans\",sans-serif);display:flex;align-items:center;justify-content:center;gap:8px;min-width:44px;min-height:44px;padding:10px 14px;border:0;border-radius:12px;background:var(--surface-raised, #513449);color:var(--cream, #FFF3DF);font-size:13px;cursor:pointer;transition:background var(--quick,160ms),transform var(--quick,160ms) var(--ease,cubic-bezier(0.16,1,0.3,1)),box-shadow var(--quick,160ms);}.ds-control svg{width:20px;height:20px;flex:0 0 auto}.ds-control:not(:disabled):hover{background:var(--surface-hover, #63465A)}.ds-control:active{transform:translateY(2px)}.ds-control:focus-visible{outline:3px solid var(--brass,#D9B464);outline-offset:4px;}.ds-control:disabled{color:var(--disabled-text, #E3CED9);cursor:not-allowed}@media(max-width:700px){.ds-control{flex-direction:column;gap:3px;padding:6px 4px;font-size:12px}.ds-control svg{width:16px;height:16px}}"
    }
  ],
  "narrative": {
    "northStar": "Velvet Verdict",
    "overview": "Velvet Verdict is a warm toy courtroom for two friends making ridiculous arguments. Burgundy holds the room, plum surfaces frame decisions, and cream keeps the conversation readable. Powder blue and apricot belong to the players; brass belongs to Bonk and the next action. The contrast between silly opinions and fair treatment is the enduring character.\n\nRounded painted frames, restrained velvet shading, Lilita One lettering, and Nunito Sans controls connect the live faces to the procedural courtroom. The scene supplies personality while the active speaker, full captions, and next action remain clear. PRODUCT.md governs behavior and claims; .impeccable/surfaces/src-app-tsx.md records the approved surface direction.",
    "keyCharacteristics": [
      "Six pinned palette roles with semantic state and material companions.",
      "Stable player identities across clients, phase changes, and departures.",
      "Live faces and readable decisions supported by a procedural brass host.",
      "Decoration responds to play while media ownership and privacy remain stable."
    ],
    "rules": [
      {
        "name": "One Source",
        "body": "Change semantic values in src/design/tokens.ts. DOM custom properties, Three.js materials, the document theme color, and the generated favicon derive from that source; DESIGN.md records the implemented system.",
        "section": "colors"
      },
      {
        "name": "Permanent Seats",
        "body": "Seat 0 stays powder blue and seat 1 stays apricot on both clients. Color follows the server-assigned seat, never local/remote position, speaking order, score rank, or winner status.",
        "section": "colors"
      },
      {
        "name": "Readable Conversation",
        "body": "Use Nunito Sans for user content, scores, timers, controls, and captions. Reserve Lilita One for the brand, short panel titles, initials, and celebratory lettering.",
        "section": "typography"
      },
      {
        "name": "Quiet Depth",
        "body": "Use soft ambient shadows and tonal plum layering around the content. Keep the small inset brass button shadow as a painted-material cue.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the six pinned color roles and the shared semantic token source.",
      "Do keep full names, propositions, positions, and captions visible; wrap or scroll long content.",
      "Do preserve media nodes across layout and phase changes through CSS placement and stable seat components.",
      "Do retain the visible Voice label on phones and distinguish activity, scoring eligibility, and mic privacy.",
      "Do provide visible focus, at least 44px interactive targets, reduced motion, and usable controls when WebGL fails.",
      "Do recapture the procedural fallback and preserve its provenance when the scene changes."
    ],
    "donts": [
      "Don't swap player identities when a player leaves, a turn changes, or the local client is the second seat.",
      "Don't use cream as the general panel background; entry, task, caption, and dialog surfaces are plum.",
      "Don't use display lettering for long arguments, infer scoring eligibility from audio level, or describe Mic on as permission to score.",
      "Don't truncate user-authored content or cover live faces and controls with celebration.",
      "Don't replace the procedural scene or live media with generated model imagery.",
      "Don't present synthetic browser coverage as physical-device, live-provider, production, or statistical-fairness validation."
    ]
  }
}

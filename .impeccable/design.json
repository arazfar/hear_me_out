      "html": "<span class=\"ds-eligible\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 9a6 6 0 0 1 12 0c0 4-4 4-4 7a4 4 0 0 1-8 0M9 9a3 3 0 0 1 6 0c0 2-3 2-3 4\"/></svg><span>Bonk is scoring</span></span>",
      "css": ".ds-eligible{font-family:var(--font-body,\"Nunito Sans\",sans-serif);display:inline-flex;align-items:center;gap:6px;min-height:22px;padding:3px 6px;border-radius:8px;background:var(--identity-seat0-base, #55D6CB);color:var(--identity-seat0-on-base, #151E32);font-size:11px;line-height:1.3}.ds-eligible svg{width:14px;height:14px;flex-shrink:0}"

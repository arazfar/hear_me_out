  "components": [
    {
      "name": "Tangerine primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Full-width next action with hover, press, focus, and disabled states.",
      "html": "<button class=\"ds-primary\">Create room</button>",
      "css": ".ds-primary{font-family:var(--font-body,\"Nunito Sans\",sans-serif);display:flex;align-items:center;justify-content:center;gap:12px;width:100%;min-width:44px;min-height:48px;padding:12px 18px;border:0;border-radius:var(--radius-small,12px);background:var(--action-primary, #FFAF45);color:var(--action-text, #151E32);font-size:15px;font-weight:700;box-shadow:var(--shadow-button,inset 0 -3px 0 #B86D1555,0 4px 10px #151E3233);cursor:pointer;transition:background var(--quick,160ms),transform var(--quick,160ms) var(--ease,cubic-bezier(0.16,1,0.3,1)),box-shadow var(--quick,160ms);}.ds-primary:not(:disabled):hover{background:var(--action-hover, #FFC36E);transform:translateY(-1px)}.ds-primary:not(:disabled):active{background:var(--action-pressed, #E99728);transform:translateY(2px) scale(.98);transition-duration:70ms}.ds-primary:focus-visible{outline:3px solid var(--border-focus, #F6F8FF);outline-offset:2px;box-shadow:0 0 0 2px var(--border-focus-gap, #151E32) !important;}.ds-primary:disabled{background:var(--status-disabled-surface, #33425B);color:var(--status-disabled-text, #B5C2D8);box-shadow:none;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },

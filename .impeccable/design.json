      "html": "<button class=\"ds-icon\" aria-label=\"How to play\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 8a3 3 0 1 1 4 3c-1 .5-1 1-1 3M12 18h.01M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z\"/></svg></button>",
      "css": ".ds-icon{display:inline-grid;place-items:center;width:44px;height:44px;min-width:44px;min-height:44px;border:0;border-radius:50%;background:var(--surface-panel, #24314B);color:var(--text-primary, #F6F8FF);cursor:pointer;transition:background var(--quick,160ms),transform var(--quick,160ms) var(--ease,cubic-bezier(0.16,1,0.3,1)),box-shadow var(--quick,160ms);}.ds-icon svg{width:20px;height:20px;flex:0 0 auto}.ds-icon:hover{background:var(--surface-hover, #3B4E6B)}.ds-icon:active{transform:translateY(2px)}.ds-icon:focus-visible{outline:3px solid var(--border-focus, #F6F8FF);outline-offset:2px;box-shadow:0 0 0 2px var(--border-focus-gap, #151E32) !important;}"

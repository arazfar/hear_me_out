      "html": "<label class=\"ds-label\" for=\"ds-name\">Your name</label><input class=\"ds-input\" id=\"ds-name\" placeholder=\"Your name\" autocomplete=\"off\">",
      "css": ".ds-label{font-family:var(--font-body,\"Nunito Sans\",sans-serif);display:block;color:var(--text-primary, #F6F8FF);font-size:14px;font-weight:600;margin:0 0 8px}.ds-input{font-family:var(--font-body,\"Nunito Sans\",sans-serif);width:100%;min-width:0;min-height:44px;padding:12px 14px;border:1.5px solid var(--border-control, #8B9DB9);border-radius:var(--radius-small,12px);background:var(--surface-input, #19263D);color:var(--text-primary, #F6F8FF);caret-color:var(--text-placeholder, #BFCBE0);color-scheme:dark;font-size:16px}.ds-input::placeholder{color:var(--text-placeholder, #BFCBE0)}.ds-input:focus-visible{outline:3px solid var(--border-focus, #F6F8FF);outline-offset:2px;box-shadow:0 0 0 2px var(--border-focus-gap, #151E32) !important;}"
    },
    {
      "name": "Room code control",
